// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = QueryCraft
PRODUCT_DISPLAY_NAME = QueryCraft
PRODUCT_BUNDLE_IDENTIFIER = io.github.future0923.QueryCraft
MARKETING_VERSION = 0.1.6
CURRENT_PROJECT_VERSION = 16
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 15.0
ALWAYS_SEARCH_USER_PATHS = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = QueryCraft/Info.plist

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/QueryCraft.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/QueryCraft.entitlements
QUERYCRAFT_SPARKLE_INSTALLER_LAUNCHER_ENABLED = YES
