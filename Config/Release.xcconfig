// Release.xcconfig
// Release configuration for macOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

// Direct Developer ID distribution. Final signing, trusted timestamps and
// notarization run after stripping/packaging. Sparkle keeps its Ed25519 key.
// The non-sandboxed host continues to use Sparkle's existing installer path.
CODE_SIGN_ENTITLEMENTS = Config/Release.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
QUERYCRAFT_SPARKLE_INSTALLER_LAUNCHER_ENABLED = NO
QUERYCRAFT_DRIVER_CATALOG_BASE_URL = https:/$()/querycraft.debug-tools.cc/drivers/

// Keep test instrumentation and local symbols out of distributed artifacts.
ENABLE_CODE_COVERAGE = NO
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = non-global-symbols
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
