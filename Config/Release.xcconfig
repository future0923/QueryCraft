// Release.xcconfig
// Release configuration for macOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

// Free direct distribution uses Sparkle's Ed25519 archive signature for the
// update trust chain. The sandbox-only launcher requires a provisioned Apple
// signature, which is unavailable to an unnotarized Personal Team release.
CODE_SIGN_ENTITLEMENTS =
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_APP_SANDBOX = NO
QUERYCRAFT_SPARKLE_INSTALLER_LAUNCHER_ENABLED = NO
QUERYCRAFT_DRIVER_CATALOG_BASE_URL = https:/$()/querycraft.debug-tools.cc/drivers/

// Keep test instrumentation and local symbols out of distributed artifacts.
ENABLE_CODE_COVERAGE = NO
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = non-global-symbols
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
